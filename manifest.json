{
  "manifest_version": 3,
  "name": "Title Tweaker Pro",
  "version": "1.0.2",
  "description": "A simple extension to tweak the title of the current tab.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "default_locale": "en",
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Title Tweaker Pro",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
